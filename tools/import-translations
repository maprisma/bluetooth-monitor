#!/usr/bin/env python3
"""Export Omarchy's read-only I18n.js as English-keyed catalogs.

Usage: tools/import-translations /path/to/omarchy-bluetooth-monitor/I18n.js
The JSON files are bundled by include_str!; this tool is not needed to build.
"""
import json
from pathlib import Path
import re
import sys

source = Path(sys.argv[1]).read_text()
raw = source.split('var STRINGS = ', 1)[1].split('\nvar MORE_PLUGINS', 1)[0].strip()
raw = re.sub(r'(?m)^  (en|de|fr|es|it|pt|nl|pl):', r'  "\1":', raw)
tables = json.loads(raw)
root = Path(__file__).resolve().parents[1] / 'translations'
for code, table in tables.items():
    out = {}
    for key, english in tables['en'].items():
        value = table[key]
        if isinstance(english, list):
            for index, text in enumerate(english):
                out[text] = value[min(index, len(value) - 1)]
        else:
            out[english] = value
    (root / f'{code}.json').write_text(json.dumps(out, ensure_ascii=False, indent=2) + '\n')
